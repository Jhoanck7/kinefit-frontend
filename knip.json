{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/app/**/*.{js,ts,jsx,tsx}",
    "next.config.*",
    "postcss.config.*",
    "src/middleware.ts",
    "src/auth.config.ts"
  ],
  "project": ["src/**/*.{js,ts,jsx,tsx}", "!src/**/*.d.ts"],
  "ignoreDependencies": ["eslint-config-next"],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": true
}
